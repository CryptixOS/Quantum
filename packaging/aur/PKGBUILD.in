# Maintainer: Szymon Zemke <v1tr10l7@proton.me>
#
# Generated from packaging/aur/PKGBUILD.in by .github/workflows/aur.yml,
# edit the template in the Quantum repository instead of the AUR copy

pkgname=quantum-term
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Framebuffer terminal emulator from CryptixOS, with an SDL2 backend for the desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/CryptixOS/Quantum'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'sdl2')
# Prism isn't packaged, it's a static library, so it's built from a pinned
# revision as part of this package, together with its meson subprojects
makedepends=('fmt' 'git' 'meson' 'ninja' 'pkgconf')
_prism_commit=@PRISM_COMMIT@
_demangler_commit=@DEMANGLER_COMMIT@
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "prism::git+https://github.com/CryptixOS/Prism.git#commit=$_prism_commit"
        "demangler::git+https://github.com/ilobilo/demangler.git#commit=$_demangler_commit"
        'https://github.com/fmtlib/fmt/archive/10.2.0/fmt-10.2.0.tar.gz'
        'https://github.com/Neargye/magic_enum/releases/download/v0.9.5/magic_enum-v0.9.5.tar.gz')
noextract=('fmt-10.2.0.tar.gz' 'magic_enum-v0.9.5.tar.gz')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            '3ca91733a7313a8ad41c0885929415f8ec0a2a31d4dc7e27e9331412f4ca26ac'
            '0694e1ef160cbb6b8be2f43c7df349295911cb7daebdd4e557adaac2c18420f9')

prepare() {
  # Provide Prism's wraps locally, so meson never has to download anything
  cd prism/subprojects
  rm -rf demangler
  cp -a "$srcdir/demangler" demangler
  # Meson only applies a wrap's overlay when it downloads the subproject
  tar -xf packagefiles/demangler.tar

  mkdir -p packagecache
  ln -sf "$srcdir/fmt-10.2.0.tar.gz" packagecache/fmt-10.2.0.tar.gz
  ln -sf "$srcdir/magic_enum-v0.9.5.tar.gz" packagecache/magic_enum-v0.9.5.tar.gz
}

build() {
  meson setup prism-build prism \
    --prefix="$srcdir/prism-root" \
    --libdir=lib \
    --buildtype=plain \
    --wrap-mode=nodownload \
    -Dwerror=false
  meson compile -C prism-build
  meson install -C prism-build --quiet

  export PKG_CONFIG_PATH="$srcdir/prism-root/lib/pkgconfig"
  arch-meson "Quantum-$pkgver" build \
    -Dsdl=enabled \
    -Dbuild_tests=true \
    -Dwerror=false
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "Quantum-$pkgver/README.md" -t "$pkgdir/usr/share/doc/$pkgname"
}
